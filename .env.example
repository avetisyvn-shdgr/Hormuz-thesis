# Copy this file to `.env` and fill in your keys. NEVER commit `.env`.
# Both keys are free and issued instantly.

# https://www.eia.gov/opendata/register.php
EIA_API_KEY=replace_with_your_eia_key

# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=replace_with_your_fred_key

# Optional dormant extension. Leave blank unless Spark access is granted.
SPARK_CLIENT_ID=
SPARK_CLIENT_SECRET=
