# Copy this file to `.env` and fill in your keys. NEVER commit `.env`.
# Both keys are free and issued instantly.

# https://www.eia.gov/opendata/register.php
EIA_API_KEY=replace_with_your_eia_key

# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=replace_with_your_fred_key

# Optional dormant extension. Leave blank unless Spark access is granted.
SPARK_CLIENT_ID=
SPARK_CLIENT_SECRET=

# Optional free vessel-data feasibility branch. Register for a personal token:
# https://globalfishingwatch.org/our-apis/
GFW_API_TOKEN=

# ---------------------------------------------------------------------
# Option D enrichment keys (importer panel + Flexibility_i). All free and
# issued instantly on registration. Leave blank until you register; code
# reads them via config.api_key("NAME") and fails loudly if a needed key
# is missing. Eurostat and ENTSOG need NO key (bulk/open API); LSEG and
# Statista are TUM logins, not keys.
# ---------------------------------------------------------------------

# EU gas storage (AGSI+) and LNG-terminal send-out (ALSI) -> Flexibility_i.
# Register (one key serves both): https://agsi.gie.eu
GIE_API_KEY=

# Japan official LNG imports by source country, monthly, via e-Stat.
# Register: https://www.e-stat.go.jp/api/
ESTAT_API_KEY=

# South Korea statistics (KOSIS) open API -- candidate Korea by-source feed.
# Register: https://kosis.kr/openapi/
KOSIS_API_KEY=

# UN Comtrade Plus -- higher pull limits (does NOT fix the 2026 Asian
# reporting lag). Register: https://comtradedeveloper.un.org/
COMTRADE_API_KEY=
